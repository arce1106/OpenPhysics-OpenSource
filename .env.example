# 本仓库独立配置。运行 python3 scripts/init_self_hosted.py 生成随机凭据。
COMPOSE_PROJECT_NAME=openphysics-selfhost
# 留空时构建本仓库的镜像；若复用兼容镜像，填写本机镜像名称并使用 --no-build。
BACKEND_IMAGE=
# 可按网络环境改为 https://registry.npmmirror.com；不需要 npm 私有凭据。
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
# 可选：发布你自己构建的客户端后填写；留空不显示下载和截图。
VITE_ANDROID_APK_URL=
VITE_ANDROID_DOWNLOAD_QR_URL=
VITE_ANDROID_TABLET_PREVIEW_URL=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_OPERATOR_NAME=
VITE_ICP_FILING=
APP_ENV=development
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=__ADMIN_PASSWORD_HASH__
ADMIN_AUTH_SECRET=__ADMIN_AUTH_SECRET__
STUDENT_AUTH_SECRET=__STUDENT_AUTH_SECRET__
TEACHER_AUTH_SECRET=__TEACHER_AUTH_SECRET__
ANSWER_IMAGE_SIGNING_SECRET=__ANSWER_IMAGE_SIGNING_SECRET__
DATABASE_URL=postgresql+asyncpg://openphysics:__POSTGRES_PASSWORD__@localhost:5543/openphysics_selfhost
REDIS_URL=redis://localhost:6389/0
CORS_ORIGINS=http://localhost:5183,http://localhost:5184,http://localhost:5186
TEACHER_PDF_FRONTEND_URL=http://teacher-frontend:5176/

# 完整自部署无需购买会员；AI 服务使用自己的账号，费用自行承担。
ARK_API_KEY=
DOUBAO_TUTOR_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_GRADING_MODEL=deepseek-flash
GRADING_PRIMARY_PROVIDER=deepseek
PAPER_GRADING_PROVIDER=doubao_single_pass
STUDENT_AI_DAILY_LIMIT_ENABLED=false
STUDENT_AI_STUDENT_CONCURRENCY=3
STUDENT_AI_GLOBAL_CONCURRENCY=12
STUDENT_AI_PER_MINUTE_LIMIT=12

# 学生账号由管理后台创建，账号密码登录。

# 可选：所有有效学生账号采用相同的每日 AI 用量限制（默认不启用）。
STUDENT_AI_DAILY_LIMIT=500
